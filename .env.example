# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_URL: The URL of the external Cloud Run backend stream proxy (leave blank to use relative path /api/proxy-video)
VITE_BACKEND_URL=""

# FRONTEND_URL: Allowed Frontend domain for CORS in the backend proxy (e.g. https://your-app.web.app)
FRONTEND_URL="https://your-domain.web.app"

# ALLOWED_HOSTS: Comma-separated allowlist of permitted stream domains (e.g. commondatastorage.googleapis.com,akwam.ss)
ALLOWED_HOSTS="commondatastorage.googleapis.com,storage.googleapis.com,akwam.ss,akwam.cx"

# Upstream source headers (Optional)
SOURCE_REFERER=""
SOURCE_ORIGIN=""
AKWAM_BASE_URL="https://akwam.ss"
