# Node.js Stream Proxy Environment Variables

# The port the backend server listens on (Cloud Run provides PORT automatically)
PORT=8080

# The Frontend URL allowed by CORS (e.g., https://your-project.web.app or http://localhost:3000)
FRONTEND_URL=https://your-domain.web.app

# Comma-separated list of allowed video hostnames (e.g. storage.googleapis.com,cdn.example.com)
# Leave empty to allow any valid public hostname while strictly blocking private IPs / localhost
ALLOWED_HOSTS=commondatastorage.googleapis.com,storage.googleapis.com,ak.sv,akwam.cx

# Optional Custom Referer and Origin for upstream video requests
SOURCE_REFERER=
SOURCE_ORIGIN=
